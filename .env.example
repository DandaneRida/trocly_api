PORT=3000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=troc
DB_PASSWORD=troc
DB_NAME=trocly_db

# Security (override with strong random secrets in production)
JWT_SECRET=replace-with-strong-random-jwt-secret
QR_SECRET=replace-with-strong-random-qr-secret

# Meta WhatsApp Cloud API — OTP Confirmation (falls back to console/dev OTP if omitted or if 24h window is closed)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v25.0

# Optional — Legacy Twilio WhatsApp OTP
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# Optional — Firebase Cloud Messaging (JSON string of service account)
FIREBASE_SERVICE_ACCOUNT_JSON=
