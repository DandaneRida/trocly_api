# ============================================
# Trocly API - Environment Configuration
# ============================================

# Node Environment
NODE_ENV=development

# ============================================
# DATABASE (PostgreSQL)
# ============================================
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=troc
DB_PASSWORD=troc
DB_NAME=trocly_db
DATABASE_URL=postgresql://troc:troc@localhost:5433/trocly_db

# ============================================
# JWT / Security
# ============================================
JWT_SECRET=your-super-secret-jwt-key-change-in-production
QR_SECRET=your-qr-signing-secret-key

# ============================================
# TWILIO - WhatsApp OTP Authentication
# ============================================
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ============================================
# FIREBASE - Cloud Messaging & Storage (Sprint 4)
# ============================================
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY=your-firebase-private-key
FIREBASE_CLIENT_EMAIL=your-firebase-client-email
FIREBASE_DATABASE_URL=https://your-project.firebaseio.com
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_KEY_PATH=./firebase-key.json

# ============================================
# REDIS - Caching & Session Management
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ============================================
# Email (Optional - Sprint 4)
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@trocly.com

# ============================================
# API Configuration
# ============================================
API_PORT=3000
API_URL=http://localhost:3000

# ============================================
# CORS & Origins
# ============================================
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:8080

# ============================================
# Rate Limiting (Sprint 4)
# ============================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# Logging
# ============================================
LOG_LEVEL=debug

# ============================================
# Scheduled Jobs (Sprint 4)
# ============================================
BULL_REDIS_URL=redis://localhost:6379
MEETING_EXPIRATION_CHECK_INTERVAL=3600000
